{
  "name": "tacos-javier-tepic",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para taquería — NLU local, sin dependencia de IA externa",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --require ./tests/setup.js --test tests/*.test.js",
    "backup": "node scripts/backup-db.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ${TENANT_ID:-tacos-javier-tepic}",
    "pm2:logs": "pm2 logs ${TENANT_ID:-tacos-javier-tepic}",
    "reset-password": "node scripts/reset-password.js",
    "onboarding": "node scripts/onboarding.js",
    "nuevo-tenant": "node scripts/nuevo-tenant.js",
    "actualizar": "node scripts/actualizar-tenants.js",
    "provisionar": "bash scripts/provisionar-tenant.sh",
    "ngrok": "node scripts/ngrok-start.js"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "conekta": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mercadopago": "^3.0.0",
    "qrcode-terminal": "^0.12.0",
    "stripe": "^22.5.0",
    "whatsapp-web.js": "^1.23.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
