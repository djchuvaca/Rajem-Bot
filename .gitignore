# ── Dependencias ───────────────────────────────────────────────
node_modules/

# ── Variables de entorno y secretos ────────────────────────────
.env
.env.local
.env.*.local
envs/

# ── WhatsApp Web JS ─────────────────────────────────────────────
.wwebjs_auth/
.wwebjs_cache/

# ── Base de datos y datos de tenants (contienen datos privados) ─
data/*.db
data/*.sqlite
data/*.sqlite3
data/tenants.json

# ── Capturas enviadas por clientes (imágenes privadas) ─────────
capturas/
analisis/capturas/

# ── Claude Code (configuración local del IDE) ──────────────────
.claude/

# ── Scripts temporales ─────────────────────────────────────────
apply_fixes.js

# ── Logs ────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep
*.log
npm-debug.log*

# ── Archivos temporales ─────────────────────────────────────────
tmp/
temp/
.cache/

# ── Sistema operativo ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──────────────────────────────────────────────────────
.vscode/
*.swp
*.swo
*~

# ── Backups de BD ───────────────────────────────────────────────
backups/*
!backups/.gitkeep

# ── Archivos de respaldo ────────────────────────────────────────
*.bak
*.old
