# ──────────────────────────────────────────────────────────────────────────────
# Bot de Tacos Javier — Variables de entorno
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# API key de Groq (https://console.groq.com → API Keys)
# Requerida para el fallback de IA cuando el parser local no puede resolver el mensaje.
GROQ_API_KEY=gsk_...

# JID del grupo de WhatsApp de administración.
# Formato: 521XXXXXXXXXX@g.us  (521 + 10 dígitos del número que creó el grupo + @g.us)
# Para obtenerlo: en el grupo de WA, envía cualquier mensaje y el bot lo imprimirá en consola.
GRUPO_ID=521XXXXXXXXXX@g.us

# Puerto del panel de administración web del tenant (default: 3000)
PANEL_PORT=3000

# Puerto del super admin (default: 3001) — proceso independiente de cualquier tenant
SUPERADMIN_PORT=3001

# Secreto para firmar las cookies de sesión del panel.
# Usa una cadena larga y aleatoria. Ejemplo: openssl rand -hex 32
PANEL_SECRET=cambia-esto-por-una-cadena-secreta-larga

# Identificador único de esta instancia del bot (sirve como clave de sesión de WhatsApp).
# Cada tenant debe tener un valor distinto para no compartir sesión WA.
# Usar formato kebab-case: letras minúsculas, números y guiones. Ej: tacos-pepe-gdl
TENANT_ID=tacos-javier-tepic

# DSN de Sentry para captura de errores en producción (opcional).
# Créalo en https://sentry.io → New Project → Node.js
# Si no se define, Sentry queda desactivado.
SENTRY_DSN=

# ── MercadoPago (opcional) ─────────────────────────────────────────────────────
# Access token de tu cuenta de MercadoPago (producción o sandbox).
# Producción: https://www.mercadopago.com.mx/developers/panel → Credenciales
# Si no se define, el flujo de transferencia sigue usando banco + foto de comprobante.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública del servidor donde corre el bot (sin slash al final).
# MercadoPago la usa para enviar notificaciones de pago (webhook).
# Ejemplo producción: https://mi-servidor.com
# Ejemplo desarrollo: https://abc123.ngrok.io  (usando ngrok)
APP_URL=

# ── Webhook de deploy automático ──────────────────────────────────────────────
# Puerto donde escucha el servidor webhook (default: 4000)
WEBHOOK_PORT=4000
# Secreto para verificar que el webhook viene de GitHub. Genera uno con: openssl rand -hex 32
WEBHOOK_SECRET=
