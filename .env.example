# ──────────────────────────────────────────────────────────────────────────────
# Rajem's Technology — Variables de entorno del SUPER ADMIN
# Este archivo es para el contenedor superadmin (node src/superadmin/standalone.js).
# Copia como .env y llena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
#
# Para variables de un tenant (bot) ver: envs/.env.tenant.example
# ──────────────────────────────────────────────────────────────────────────────

# ── Super admin ───────────────────────────────────────────────────────────────

# Puerto del panel super admin (default: 3001)
SUPERADMIN_PORT=3001

# Secreto para firmar las cookies de sesión del super admin.
# Genera uno con: openssl rand -hex 32
SUPERADMIN_SECRET=cambia-esto-por-una-cadena-secreta-larga

# ── Webhook de provisionamiento (opcional) ────────────────────────────────────
# Puerto donde escucha webhook-deploy.js en el host (default: 4000)
# Solo necesario si usas provisionamiento automático desde el panel.
WEBHOOK_PORT=4000

# Secreto compartido entre el panel y webhook-deploy.js.
# Genera uno con: openssl rand -hex 32
# Si se deja vacío, el webhook no valida la firma (no recomendado en producción).
WEBHOOK_SECRET=

# ── Config global de IA (se guarda en admin.db, editable desde el panel) ──────
# Estos valores se usan solo como semilla inicial al crear admin.db.
# Después se gestionan desde el panel superadmin → Configuración global.

# API key de Groq — se propaga a todos los tenants desde el panel
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Timeout para llamadas a Groq en ms (default: 15000)
GROQ_TIMEOUT_MS=15000

# URL pública del servidor (sin slash al final). Usada por MercadoPago webhook.
# Ejemplo: https://mi-servidor.com
APP_URL=

# DSN de Sentry para captura de errores (opcional)
# https://sentry.io → New Project → Node.js
SENTRY_DSN=
