# ──────────────────────────────────────────────────────────────────────────────
# Rajem's Technology — Variables de entorno de un TENANT (bot)
# Copia como envs/{TENANT_ID}.env y llena los valores reales.
# NUNCA subas estos archivos al repositorio (ya están en .gitignore).
#
# Para variables del superadmin ver: .env.example
# ──────────────────────────────────────────────────────────────────────────────

# ── Identificación del tenant ─────────────────────────────────────────────────

# Identificador único de esta instancia del bot (sirve como clave de sesión WA).
# Cada tenant debe tener un valor distinto. Formato kebab-case: tacos-pepe-gdl
TENANT_ID=tacos-javier-tepic

# ── WhatsApp ──────────────────────────────────────────────────────────────────

# JID del grupo de WhatsApp de administración del negocio.
# Formato: 521XXXXXXXXXX@g.us  (521 + 10 dígitos del número que creó el grupo)
# Para obtenerlo: envía cualquier mensaje al grupo y el bot lo imprimirá en consola.
GRUPO_ID=521XXXXXXXXXX@g.us

# ── Panel web del tenant ──────────────────────────────────────────────────────

# Puerto del panel de administración web (default: 3000)
# Cada tenant debe tener un puerto distinto: 3000, 3002, 3003...
PANEL_PORT=3000

# Secreto para firmar las cookies de sesión del panel.
# Genera uno con: openssl rand -hex 32
PANEL_SECRET=cambia-esto-por-una-cadena-secreta-larga

# ── IA (Groq) ─────────────────────────────────────────────────────────────────
# Si el superadmin tiene GROQ_API_KEY configurada en la BD global,
# el tenant la hereda automáticamente. Solo define aquí si quieres sobrescribirla.
GROQ_API_KEY=
GROQ_TIMEOUT_MS=15000

# ── MercadoPago (opcional) ────────────────────────────────────────────────────
# Access token de MercadoPago del negocio.
# Producción: https://www.mercadopago.com.mx/developers/panel → Credenciales
# Si no se define, el flujo usa banco + foto de comprobante.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública del servidor (sin slash al final). Necesaria si MP está activo.
APP_URL=

# ── Monitoreo (opcional) ──────────────────────────────────────────────────────
SENTRY_DSN=
